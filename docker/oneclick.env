# =============================================================================
# Octop 一键启动 — 默认配置
#
# 由 docker/octop-up.sh（或 docker/octop-up.cmd）通过 --env-file 读取。
# 想改端口 / 数据目录 / 首次管理员，改这里即可，不用动 compose 文件。
#
# 注意：Compose 只会把「docker-compose.oneclick.yml 的 environment: 段里
# 列出的键」注入容器，这里多余的键仅参与变量插值。要新增注入项，请同步修
# 改 compose 的 environment 段。
# =============================================================================

# ---- 运行时 ----
OCTOP_PORT=8088
OCTOP_LOG_LEVEL=info

# ---- 数据盘 ----
# 容器内 HOME=/data → 实际数据落在 <OCTOP_DATA> 指向的宿主机目录。
# 默认放到 D 盘，避免占用系统盘（Windows 下 Compose 接受 D:/ 正斜杠写法）。
# 非 Windows 环境请在启动脚本里覆盖 OCTOP_DATA，或直接改成本机路径。
OCTOP_DATA=D:/octop-data/.octop

# ---- 首次初始化管理员 ----
# DEFAULT_PASSWORD 留空 = 首次启动自动生成随机强密码，
# 并写入 <OCTOP_DATA>/credential.txt。首次登录后请立即改密。
OCTOP_ADMIN_USERNAME=admin
OCTOP_ADMIN_DISPLAY_NAME=Admin
OCTOP_DEFAULT_PASSWORD=

# ---- LLM 凭证（可选，也可稍后在控制台里配）----
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# ---- 可观测性（可选）----
# 未配置 Langfuse 时置 false，避免无谓的连接重试与日志噪音。
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ---- PostgreSQL（仅 --postgres 模式使用）----
OCTOP_PG_PORT=5432
OCTOP_PG_USER=octop
OCTOP_PG_PASSWORD=octop
OCTOP_PG_DB=octop
